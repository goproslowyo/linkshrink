# linkshrink settings for the Caddyfile next to this (all of them: README "Settings")
LINKSHRINK_LISTEN=127.0.0.1:8080
LINKSHRINK_PUBLIC_ORIGIN=https://go.example.com
LINKSHRINK_TRUSTED_PROXY=127.0.0.1
LINKSHRINK_GATE_SECRET_FILE=/etc/caddy/gate-secret
LINKSHRINK_USER_GROUP=go-users
LINKSHRINK_ADMIN_GROUP=go-admins
LINKSHRINK_HELP=Ask an admin for access.
LINKSHRINK_REDIRECT_CACHE_SECS=60
LINKSHRINK_DB=/var/lib/linkshrink/links.db
